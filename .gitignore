# Ignore everything at the root by default; this repo only tracks
# ViTbackend/ and app/ out of the larger dissertation workspace.
/*
!/ViTbackend/
!/app/
!/.gitignore
!/README.md

# Build artifacts / large or generated files within the tracked folders
ViTbackend/__pycache__/
ViTbackend/outputs/*.pth
ViTbackend/masking_failures.log
app/models/*.pth
.venv/
**/__pycache__/
*.pyc
